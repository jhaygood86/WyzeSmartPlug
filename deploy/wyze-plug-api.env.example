# /etc/wyze-plug-api.env  (chmod 600, owned by root)
Wyze__Email=you@example.com
Wyze__Password=changeme
Wyze__KeyId=your-wyze-key-id
Wyze__ApiKey=your-wyze-api-key
# Wyze's API is IPv4-only; on an IPv6-only host, route it through Cloudflare WARP in proxy mode.
Wyze__Proxy=socks5://127.0.0.1:40000
# Optional: require this value in an X-Api-Key header
#Api__Key=
